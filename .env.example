# システムLLM（AWS Bedrock）用の認証情報
# 使用方法: このファイルを .env にコピーして認証情報を設定
#   cp .env.example .env
#
# 注意: .env は .gitignore に含まれるためコミットされません
# 注意: AWS環境がない場合、この設定は不要です。
#       Web画面から設定ファイルをアップロードすることで、
#       Anthropic APIやOpenAI APIを使用できます。

AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=ap-northeast-1

# md2map分割設定
# NLP/AIモード分割時の1セクションあたり最大サブスプリット数（デフォルト: 5）
MD2MAP_MAX_SUBSECTIONS=5

# CORS設定（デフォルト: ローカル開発用オリジンのみ許可）
# ブラウザからのクロスオリジンアクセスを許可するオリジンをカンマ区切りで
# 指定します。未設定時は Vite の開発サーバー／プレビュー
# （http://localhost:5173 等）のみを許可します。
#
# 通常の構成では設定不要です。開発時は Vite の proxy がサーバー側で /api を
# 中継し、本番は同じ FastAPI アプリがフロントエンドを配信するため、いずれも
# 同一オリジンとなり CORS は発生しません。フロントエンドを別ホストで動かす
# 場合のみ設定してください。
#
# 注意: `*`（全許可）も指定できますが、任意のサイトから応答を読めるように
#       なるため推奨しません（その場合は認証情報の送受信を無効化します）。
# CORS_ORIGINS=https://example.com

# ローカルLLM接続用（デフォルト: false）
# 設定ファイルの baseUrl に内部ネットワーク宛のアドレス
# （127.0.0.1、192.168.x.x 等）を指定できるようにします。
#
# 既定では内部ネットワーク宛を拒否します。このAPIは認証なしで公開される
# ため、検証しないとサーバーを踏み台にして内部ネットワークやクラウドの
# メタデータエンドポイントへ到達できてしまうためです。
#
# ローカルで動かしているLLM（Ollama、LM Studio等）に接続する場合のみ、
# 次の行のコメントを外してください。
# 注意: 信頼できない相手がこのAPIを呼べる環境では有効にしないでください。
# LLM_ALLOW_PRIVATE_BASE_URL=1
